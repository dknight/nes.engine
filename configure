#!/usr/bin/env bash

set -e

REQUIRED_TOOLS=(
	ca65
	ld65
	sim65
	make
)

OPTIONAL_TOOLS=(
	lua
)

echo "Checking dependencies..."

for tool in "${REQUIRED_TOOLS[@]}"; do
	if ! command -v "$tool" >/dev/null 2>&1; then
	    echo "Error: '$tool' not found."
	    exit 1
	fi
	version=$("$tool" --version 2>&1 | tr '\n' ' ')
	printf 'Found: %s (%s) %s\n' "$tool" "$(command -v "$tool")" "$version"
done

echo
echo "Checking optional dependencies..."

for tool in "${OPTIONAL_TOOLS[@]}"; do
	if command -v "$tool" >/dev/null 2>&1; then
		version=$("$tool" -v 2>&1 | tr '\n' ' ')
		printf 'Found: %s (%s) %s\n' "$tool" "$(command -v "$tool")" "$version"
	else
		printf 'Info: %s not found. Optional features will be unavailable.\n' "$tool"
	fi
done

echo
echo "All dependencies satisfied."
echo "Configuration completed successfully."

